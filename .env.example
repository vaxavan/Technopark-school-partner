# Скопируйте этот файл в .env и заполните значения.
# Пустое значение = функция работает в демо-режиме (без внешнего сервиса).

# ---------- Django ----------
# Домен сервера (только для docker-compose.prod.yml), например news.technopark-istok.ru
DOMAIN=
# Любая длинная случайная строка. Сгенерировать:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=1
# Адрес, по которому система открывается (для ссылок в письмах и RSS)
SITE_URL=http://localhost:8000
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Порт, на котором открывается система (на сервере без домена — 80, если порт свободен)
HTTP_PORT=8000
# Число процессов: на сервере с 2 ГБ памяти, где работает что-то ещё, — 2 и 1
WEB_WORKERS=3
CELERY_CONCURRENCY=2
# Ключ шифрования токенов площадок в базе. Сгенерировать:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# ---------- Первая организация и пользователи (команда init_system) ----------
# Вход в систему — по e-mail. Если e-mail не указан, будет director@istok.local / admin@istok.local
ORG_CODE=istok
ORG_NAME=Технопарк «Исток — РТУ МИРЭА»
DIRECTOR_EMAIL=
DIRECTOR_NAME=Директор
DIRECTOR_PASSWORD=
ADMIN_EMAIL=
ADMIN_NAME=Администратор
ADMIN_PASSWORD=

# ---------- YandexGPT (Yandex AI Studio) ----------
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
# Модель для текстов и модель для уточняющих вопросов
YANDEX_MODEL=yandexgpt/latest
YANDEX_MODEL_LITE=yandexgpt-lite/latest

# ---------- Почта (SMTP) ----------
# Пример для Яндекса: smtp.yandex.ru, 465, SSL=1, пароль приложения
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_USE_SSL=1
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
# Пауза между письмами школам, секунд
MAIL_PAUSE_SECONDS=2

# ---------- ВКонтакте (токен ПОЛЬЗОВАТЕЛЯ-администратора группы) ----------
VK_GROUP_ID=
VK_ACCESS_TOKEN=
# Для проверки размещения у школ во ВКонтакте (сервисный ключ приложения, необязательно)
VK_SERVICE_TOKEN=

# ---------- Telegram (бот — администратор канала) ----------
TELEGRAM_BOT_TOKEN=
# @имя_канала для публичного канала или -100… для закрытого канала/группы
TELEGRAM_CHAT_ID=

# ---------- Max (Bot API) ----------
MAX_BOT_TOKEN=
MAX_CHAT_ID=
# Путь к корневому сертификату Минцифры, если Python его не принимает
MAX_CA_BUNDLE=

# ---------- Контроль школ ----------
# Сколько напоминаний максимум и через сколько дней
REMINDERS_MAX=2
REMINDER_INTERVAL_DAYS=3
# Время ежедневного обхода сайтов школ (час, по Москве)
CRAWL_HOUR=6

# ---------- Снимки страниц ----------
# playwright или none
SNAPSHOT_BACKEND=playwright
